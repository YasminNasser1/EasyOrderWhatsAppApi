<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1903</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);EasyOrderWhatsAppDAL\**;EasyOrderWhatsAppBLL\**;WhatsAppGateway\node_modules\**;WhatsAppGateway\auth_info\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="WhatsAppGateway\server.js" />
    <None Include="WhatsAppGateway\package.json" />
    <None Include="WhatsAppGateway\src\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\**" />
    <Compile Remove="Models\**" />
    <Content Remove="Services\**" />
    <Content Remove="Models\**" />
    <EmbeddedResource Remove="Services\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Services\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="EasyOrderWhatsAppBLL\EasyOrderWhatsAppBLL.csproj" />
  </ItemGroup>

</Project>
